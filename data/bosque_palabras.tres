[resource]
script = ExtResource("2_ii8ht")
id_mundo = "bosque_palabras"
nombre_mundo = "Bosque de las Palabras"
ubicacion = "Sierra de Juarez"
nombre_personaje = "Buhito"
texto_intro = "Hola! Soy Buhito, el buho sabio del bosque. La C, la S y la Z suenan parecido pero no se escriben igual. La Z casi siempre anda con las vocales A, O, U. La C casi siempre anda con las vocales E, I."
trucos = Array[String](["La Z casi siempre anda con las vocales A, O, U (zapato, zorro)", "La C casi siempre anda con las vocales E, I (cielo, cine)"])
bancos_palabras = Array[ExtResource("1_bloud")]([ExtResource("2_2svf1")])
palabras_reto_final = Array[String](["consciencia", "ascenso", "cerezo", "exceso", "ansiedad", "cizana", "sinceridad", "escenario", "zozobra", "esclusa", "conciso", "seduccion", "cansancio", "ejercicio", "sensatez", "cosecha", "escoces", "silencio", "zarzuela", "sucesion"])
monedas_recompensa = 50
skin_recompensa = "Corona de ramas"
